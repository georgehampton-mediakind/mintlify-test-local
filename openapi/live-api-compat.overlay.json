{
  "overlay": "1.0.0",
  "info": {
    "title": "ECMAScript named capture syntax for Mintlify rendering",
    "version": "1.0.0"
  },
  "extends": "./mkio/live-api.json",
  "actions": [
    {
      "target": "$[\"components\"][\"schemas\"][\"LiveChannelFlow\"][\"properties\"][\"archiveWindowLength\"]",
      "update": {
        "pattern": "^P(?:(?<years>\\d+)Y)?(?:(?<months>\\d+)M)?(?:(?<weeks>\\d+)W)?(?:(?<days>\\d+)D)?T(?:(?<hours>\\d+)H)?(?:(?<minutes>\\d+)M)?(?:(?<seconds_fract>(?:\\d*.)?\\d+)S)?$"
      }
    },
    {
      "target": "$[\"components\"][\"schemas\"][\"LiveEventFlow\"][\"properties\"][\"archiveWindowLength\"]",
      "update": {
        "pattern": "^P(?:(?<years>\\d+)Y)?(?:(?<months>\\d+)M)?(?:(?<weeks>\\d+)W)?(?:(?<days>\\d+)D)?T(?:(?<hours>\\d+)H)?(?:(?<minutes>\\d+)M)?(?:(?<seconds_fract>(?:\\d*.)?\\d+)S)?$"
      }
    },
    {
      "target": "$[\"components\"][\"schemas\"][\"StaticMultiviewChannelFlow\"][\"properties\"][\"archiveWindowLength\"]",
      "update": {
        "pattern": "^P(?:(?<years>\\d+)Y)?(?:(?<months>\\d+)M)?(?:(?<weeks>\\d+)W)?(?:(?<days>\\d+)D)?T(?:(?<hours>\\d+)H)?(?:(?<minutes>\\d+)M)?(?:(?<seconds_fract>(?:\\d*.)?\\d+)S)?$"
      }
    },
    {
      "target": "$[\"components\"][\"schemas\"][\"StaticMultiviewEventFlow\"][\"properties\"][\"archiveWindowLength\"]",
      "update": {
        "pattern": "^P(?:(?<years>\\d+)Y)?(?:(?<months>\\d+)M)?(?:(?<weeks>\\d+)W)?(?:(?<days>\\d+)D)?T(?:(?<hours>\\d+)H)?(?:(?<minutes>\\d+)M)?(?:(?<seconds_fract>(?:\\d*.)?\\d+)S)?$"
      }
    }
  ]
}
