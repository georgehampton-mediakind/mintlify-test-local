  "keyFeatures": [
    "Cloud-native live and VOD media processing via MK.IO SaaS platform",
    "On-premises edge encoding, packaging, and decoding via MK.IO Beam appliances",
    "Multi-product unified API surface: Media, Live, Templates, Management, Fleets, Infrastructure, and Channels APIs",
    "REST API with bearer token authentication shared across all cloud APIs",
    "Live event ingest (RTMP, SRT, SMPTE 2110) with HLS/DASH packaging and DRM protection",
    "VOD transcode pipeline with reusable transforms, jobs, and output assets",
    "Multiview composition of multiple live sources into a single tiled output",
    "AI-powered workflows including multi-language VOD dubbing and transcription",
    "Fleet management for on-premises Beam devices: registration, software updates, backups, and support packages",
    "Webhook event notifications for job completion, resource state changes, and more",
    "Model Context Protocol (MCP) server for AI tool integration with MediaKind documentation",
    "Content protection with PlayReady, Widevine, FairPlay DRM and content key policies",
    "Organization-level multi-project management with RBAC, teams, and billing"
  ],
  "publicApiSurface": [
    "GET /api/v1/projects/{project_name}/media/assets — list and retrieve media assets",
    "PUT /api/v1/projects/{project_name}/media/assets/{asset_name} — create or update asset",
    "GET /api/v1/projects/{project_name}/media/transforms — list transcode templates",
    "PUT /api/v1/projects/{project_name}/media/transforms/{transform_name}/jobs/{job_name} — submit transcode job",
    "PUT /api/v1/projects/{project_name}/media/liveEvents/{live_event_name} — create live event",
    "POST /api/v1/projects/{project_name}/media/liveEvents/{live_event_name}/start — start live event",
    "PUT /api/v1/projects/{project_name}/media/streamingLocators/{locator_name} — create streaming locator",
    "POST /api/v1/projects/{project_name}/media/streamingLocators/{locator_name}/listPaths — retrieve playback URLs",
    "GET /api/v1/projects/{project_name}/live/liveChannels — list Live API channels",
    "PUT /api/v1/projects/{project_name}/live/liveChannels/{channel_name} — create Live API channel",
    "GET /api/v1/projects/{project_name}/templating/templates — list encoding templates",
    "PUT /api/v1/projects/{project_name}/fleet/devices/{device_name} — register fleet device",
    "POST /api/v1/projects/{project_name}/fleet/devices/{device_name}/backup — backup device configuration",
    "GET /api/v1/projects/{project_name}/infra/networks — list infrastructure networks",
    "GET /api/v1/organizations/{org_name}/users — list organization users",
    "POST /api/v1/organizations/{org_name}/webhookRules — create webhook notification rule",
    "GET /api/channels/ — Channels API: list channels on Beam device",
    "PUT /api/channels/{channel_id}/ — Channels API: create or update channel on Beam device"
  ]
}
